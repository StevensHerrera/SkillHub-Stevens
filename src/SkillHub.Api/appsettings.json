{
  "ConnectionStrings": {
    "DefaultConnection": "Data Source=skillhub.db"
  },
  "Jwt": {
    "Issuer": "SkillHub.Api",
    "Audience": "SkillHub.Web",
    "ExpiresMinutes": 120,
    "Key": ""
  },
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:4200",
      "http://127.0.0.1:4200"
    ]
  },
  "Swagger": {
    "Enabled": false
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
